<%- include('../include/header') %>

<div class="container">
    <%- include('../include/partials/spinner') %>

    <%- include('../include/partials/responseMessage') %>

    <div class="games hidden" id="games">
        <div class="games-top">
            <h1>Games</h1>
        </div>

        <p class="hidden" id="no-games-message">No Games Found</p>

        <ul class="games-list hidden" id="games-list"></ul>

        <div class="games-bottom">
            <button id="funny-mode">Funny Mode</button>
        </div>
    </div>
</div>

<div class="fixed-element-container form-container hidden" id="create-room-form-container">
    <form id="create-room-form">
        <div class="input-group">
            <label>Game Time</label>
            <select id="game-time">
                <option value="0">No Time</option>
                <option value="1">1 Minute</option>
                <option value="2">3 Minutes</option>
                <option value="3">5 Minutes</option>
                <option value="4">10 Minutes</option>
                <option value="5">15 Minutes</option>
                <option value="6">30 Minutes</option>
                <option value="7">45 Minutes</option>
                <option value="8">60 Minutes</option>
            </select>
        </div>
        <button type="submit" id="join-random">Join Random</button>

        <span class="close-form" id="close-create-form">
            &#x2715;
        </span>
    </form>
</div>

<%- include('../include/partials/chat') %>

<script src="/socket.io/socket.io.js"></script>
<script src="js/spinner.js"></script>
<script src="js/index.js"></script>
<script src="js/games2.js"></script>
<script src="js/responseMessage.js"></script>
<script src="js/chat.js"></script>

<%- include('../include/footer') %>