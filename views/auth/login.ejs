<%- include('../include/header') %>

<div class="container c-color">
    <%- include('../include/partials/responseMessage') %>

    <form action="/api/login" method="POST" class="flex-center-column auth-form">
        <h1 class="flex-center-row">Login to Play <img src="/assets/icons/user-check.svg" alt="User"></h1>

        <div class="input-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="Enter your email...">
        </div>

        <div class="input-group">
            <label>Password</label>
            <input type="password" name="password" placeholder="Enter your password...">
        </div>

        <button type="submit" name="submit">LOGIN</button>
        <a href="/register" id="create-account">CREATE ACCOUNT</a>
    </form>
</div>

<script src="js/responseMessage.js"></script>

<%- include('../include/footer') %>