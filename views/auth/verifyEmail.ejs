<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmar e-mail</title>
</head>

<body>
    <h1>Confirme seu e-mail</h1>
    <p> Enviamos um código de confirmação para o seu e-mail. </p>
    <form action="/api/verifyEmail" method="POST">
        <label for="codigo"> Código de confirmação: </label>
        <input type="text" id="codigo" name="codigo" placeholder="Digite o código" maxlength="6" required>
        <button type="submit">Confirmar e-mail </button>
    </form>
</body>

</html>