<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmar e-mail</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body id="body-verify">
    <h1>Confirme seu e-mail</h1>
    <p> Enviamos um código de confirmação para o seu e-mail. </p>
    <form action="/api/verifyEmail" method="POST">
        <input type="hidden" name="userId" value="<%= userId %>">
        <label for="codigo"> Código de confirmação: </label>
        <input type="text" id="codigo" name="codigoInformado" placeholder="Digite o código" maxlength="6" required>
        <button type="submit" id="verify-button">Confirmar e-mail </button>
    </form>
</body>

</html>