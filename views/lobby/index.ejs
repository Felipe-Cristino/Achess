<%- include('../include/header') %>

    <div class="container">
        <%- include('../include/partials/spinner') %>

            <%- include('../include/partials/responseMessage') %>

                <div class="lobby hidden" id="lobby">
                    <div class="my-info">
                        <h4>My Info</h4>

                        <ul class="flex2">
                            <li class="flex6">
                                <label>Username</label>
                                <div class="flex5">
                                    <span id="username">testuser</span>
                                    <img id="imagem-profile" src="" alt="Perfil Image">
                                </div>
                            </li>
                            <button id="btn1">Funny</button>
                            <button id="btn2" class="hidden">Normal</button>
                            <div class="flex3">
                                <li>
                                    <label>Rank Normal Rapid</label>
                                    <div class="flex1">
                                        <span id="rank_normal_rapid">Silver</span>
                                        <span id="points_normal_rapid">1500</span>
                                        <img id="brasao_normal_rapid" class="brasao" src="/assets/brasoes/brasao-silver.jpeg">
                                    </div>
                                </li>
                                <li>
                                    <label>Rank Normal Blitz</label>
                                    <div class="flex1">
                                        <span id="rank_normal_blitz">Silver</span>
                                        <span id="points_normal_blitz">1500</span>
                                        <img id="brasao_normal_blitz" class="brasao" src="/assets/brasoes/brasao-silver.jpeg">
                                    </div>
                                </li>
                                <li>
                                    <label>Rank Normal Bullet</label>
                                    <div class="flex1">
                                        <span id="rank_normal_bullet">Silver</span>
                                        <span id="points_normal_bullet">1500</span>
                                        <img id="brasao_normal_bullet" class="brasao" src="/assets/brasoes/brasao-silver.jpeg">
                                    </div>
                                </li>
                            </div>
                            <div class="flex4 hidden">
                                <li>
                                    <label>Rank Funny Rapid</label>
                                    <div class="flex1">
                                        <span id="rank_funny_rapid">Silver</span>
                                        <span id="points_funny_rapid">1500</span>
                                        <img id="brasao_funny_rapid" class="brasao" src="/assets/brasoes/brasao-silver.jpeg">
                                    </div>
                                </li>
                                <li>
                                    <label>Rank Funny Blitz</label>
                                    <div class="flex1">
                                        <span id="rank_funny_blitz">Silver</span>
                                        <span id="points_funny_blitz">1500</span>
                                        <img id="brasao_funny_blitz" class="brasao" src="/assets/brasoes/brasao-silver.jpeg">
                                    </div>
                                </li>
                                <li>
                                    <label>Rank Funny Bullet</label>
                                    <div class="flex1">
                                        <span id="rank_funny_bullet">Silver</span>
                                        <span id="points_funny_bullet">1500</span>
                                        <img id="brasao_funny_bullet" class="brasao" src="/assets/brasoes/brasao-silver.jpeg">
                                    </div>
                                </li>
                            </div>
                        </ul>
                    </div>

                    <div class="rooms">
                        <h1>Rooms</h1>

                        <div class="room">
                            <a href="/games">Play Game</a>
                            <br>
                            <a href="/games2">Funny Mode</a>
                        </div>

                        <p class="total" id="total-users">Total Users: 100</p>
                        <p class="total" id="total-rooms">Total Rooms: 50</p>
                    </div>
                </div>
    </div>

    <%- include('../include/partials/chat') %>

        <script src="/socket.io/socket.io.js"></script>
        <script src="js/spinner.js"></script>
        <script src="js/index.js"></script>
        <script src="js/lobby.js"></script>
        <script src="js/responseMessage.js"></script>
        <script src="js/chat.js"></script>

        <%- include('../include/footer') %>