<%- include('../include/header') %>

    <div class="container">
        <%- include('../include/partials/responseMessage') %>
            <form id="config-form">
                <h1>Styles</h1>
                <hr id="styles-hr">
                <h2>Pieces</h2>
                <div id="square" class="flex9">
                    <h5>Default Pieces</h5>
                    <img class="piece-config" src="/assets/chess-pieces/square/black/chess-knight.svg">
                </div>
                <div id="chromePlated" class="flex9">
                    <h5>Default Chrome-Plated Pieces</h5>
                    <img class="piece-config" src="/assets/chess-pieces/chromePlated/black/chess-knight.svg">
                </div>
                <div id="heavy" class="flex9">
                    <h5>Heavy Pieces</h5>
                    <img class="piece-config" src="/assets/chess-pieces/heavy/black/chess-knight.svg">
                </div>
                <div id="heavyNatalino" class="flex9">
                    <h5>Heavy Natalino Pieces</h5>
                    <img class="piece-config" src="/assets/chess-pieces/heavyNatalino/black/chess-knight.svg">
                </div>
                <h2>Chess Board</h2>
                <div id="green-board" class="flex10">
                    <h5>Default Board</h5>
                    <p id="green" class="board-config"></p>
                </div>
                <div id="blue-board" class="flex10">
                    <h5>Blue Board</h5>
                    <p id="blue" class="board-config"></p>
                </div>
                <button id="choose-op">Choose Options</button>
            </form>
    </div>
    <%- include('../include/partials/chat') %>

        <script src="/socket.io/socket.io.js"></script>
        <script src="js/spinner.js"></script>
        <script src="js/index.js"></script>
        <script src="js/config.js"></script>
        <script src="js/responseMessage.js"></script>

        <%- include('../include/footer') %>